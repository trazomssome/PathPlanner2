## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
build/
bld/
[Bb]in/
[Oo]bj/

# Exclude compiled libraries
*.dll
!Libs/**        # keep DLLs in Libs folder if manually managed

# Roslyn cache directories
*.ide/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

#NUNIT
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

*_i.c
*_p.c
*_i.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Chutzpah Test files
_Chutzpah*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# TFS 2012 Local Workspace
$tf/

# Guidance Automation Toolkit
*.gpState

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode
.JustCode

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield
[Ee]xpress/

# DocProject
DocProject/buildhelp/
DocProject/Help/

# ClickOnce
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml

# NuGet
packages/*
!packages/build/

# Windows Azure Build Output
csx/
*.build.csdef

# Windows Store app package
AppPackages/

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.pfx
*.publishsettings
node_modules/
Generated_Code/

# Backup and upgrade logs
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server
*.mdf
*.ldf

# BI
*.rdl.data
*.bim.layout
*.bim_*.settings

# Microsoft Fakes
FakesAssemblies/

# ----------------------------
# WinForms & C# Common Section
# ----------------------------

# Auto-generated designer files
*.Designer.cs
*.resx
*.resources

# Local user settings
*.local.config
*.userprefs
*.config

# App data and cache
App_Data/
*.cache
*.bak
*.old

# Logs
*.log
*.trace
*.dmp

# ClickOnce / Setup
*.manifest
*.application
*.ClickOnce/
ReleasePublish/
Installer/
Setup/
Bootstrapper/

# Test results
TestResults/
*.trx

# EF / LINQ-to-SQL
*.edmx.diagram
*.dbschema
*.dbml
*.dbml.layout

# Localization
*.resources.dll

# IIS Express
.vs/
.vs/config/applicationhost.config
iisexpress.log

# StyleCop, NCrunch, etc.
StyleCop.Cache
*.ncrunchproject

git_stats/*
