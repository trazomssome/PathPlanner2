<UserControl x:Class="DispenserEditor.Controls.PathSegmentEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:models="clr-namespace:DispenserEditor.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             MinHeight="600"
             MinWidth="1024">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="SegmentTypeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SegmentType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <ToolBar Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Padding="6"
                 Background="#e0e4e9"
                 ToolBarTray.IsLocked="True">
            <Button Click="OnLoadImage">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Image" Margin="0,0,6,0" />
                    <TextBlock Text="Load Image" />
                </StackPanel>
            </Button>
            <Separator />
            <ToggleButton Tag="Move" IsChecked="True" Checked="OnModeChanged">
                <TextBlock Text="Move" />
            </ToggleButton>
            <ToggleButton Tag="Line" Checked="OnModeChanged">
                <TextBlock Text="Line" />
            </ToggleButton>
            <ToggleButton Tag="Point" Checked="OnModeChanged">
                <TextBlock Text="Point" />
            </ToggleButton>
            <ToggleButton IsChecked="{Binding ShowLinePoints, Mode=TwoWay}" Margin="16,0,0,0">
                <TextBlock Text="Show Line Points" />
            </ToggleButton>
            <Separator />
            <Button Click="OnAddSegment">
                <TextBlock Text="Add" />
            </Button>
            <Button Click="OnDuplicateSegment">
                <TextBlock Text="Duplicate" />
            </Button>
            <Button Click="OnRemoveSegment">
                <TextBlock Text="Remove" />
            </Button>
            <Separator />
            <Button Click="OnUndo">
                <TextBlock Text="Undo" />
            </Button>
            <Button Click="OnRedo">
                <TextBlock Text="Redo" />
            </Button>
            <Separator />
            <Button Click="OnImportRecipe">
                <TextBlock Text="Import" />
            </Button>
            <Button Click="OnExportRecipe">
                <TextBlock Text="Export" />
            </Button>
        </ToolBar>

        <Grid Grid.Row="1" Grid.Column="0">
            <Border BorderBrush="#889" BorderThickness="1" Background="#111">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CanvasHost" Background="Black" ClipToBounds="True">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTransform" />
                                <TranslateTransform x:Name="PanTransform" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Image x:Name="ReferenceImage"
                               Source="{Binding ReferenceImage}"
                               Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}" />

                        <Canvas x:Name="OverlayCanvas"
                                Width="{Binding ImageWidth}"
                                Height="{Binding ImageHeight}"
                                IsHitTestVisible="False" />

                        <Line x:Name="CrosshairHorizontal" Stroke="#FF00FF" StrokeDashArray="4 4" StrokeThickness="1" />
                        <Line x:Name="CrosshairVertical" Stroke="#FF00FF" StrokeDashArray="4 4" StrokeThickness="1" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Segments" Margin="0,0,0,12">
                <DataGrid ItemsSource="{Binding Segments}"
                          SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BeginningEdit="OnSegmentEditBegin"
                          CellEditEnding="OnSegmentEditEnd">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Type"
                                                SelectedItemBinding="{Binding SegmentType, Mode=TwoWay}"
                                                ItemsSource="{Binding Source={StaticResource SegmentTypeValues}}" />
                        <DataGridTextColumn Header="Group" Binding="{Binding LineGroup, Mode=TwoWay}" />
                        <DataGridTextColumn Header="X" Binding="{Binding X, Mode=TwoWay, StringFormat=F3}" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=TwoWay, StringFormat=F3}" />
                        <DataGridCheckBoxColumn Header="Dispense" Binding="{Binding OnDispensing, Mode=TwoWay}" />
                        <DataGridTextColumn Header="Speed" Binding="{Binding Speed, Mode=TwoWay, StringFormat=F2}" />
                        <DataGridTextColumn Header="Accel" Binding="{Binding Acceleration, Mode=TwoWay, StringFormat=F2}" />
                        <DataGridTextColumn Header="Decel" Binding="{Binding Deceleration, Mode=TwoWay, StringFormat=F2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Segment Details">
                <Grid DataContext="{Binding SelectedSegment}" Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Type" Margin="0,0,8,4" />
                    <ComboBox Grid.Column="1" SelectedItem="{Binding SegmentType, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource SegmentTypeValues}}" />

                    <TextBlock Grid.Row="1" Text="Group" Margin="0,4,8,4" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LineGroup, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Text="X" Margin="0,4,8,4" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding X, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Text="Y" Margin="0,4,8,4" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Y, Mode=TwoWay}" />

                    <TextBlock Grid.Row="4" Text="Dispense" Margin="0,4,8,4" />
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding OnDispensing, Mode=TwoWay}" />

                    <TextBlock Grid.Row="5" Text="Speed" Margin="0,4,8,4" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Speed, Mode=TwoWay}" />

                    <TextBlock Grid.Row="6" Text="Accel" Margin="0,4,8,4" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Acceleration, Mode=TwoWay}" />

                    <TextBlock Grid.Row="7" Text="Decel" Margin="0,4,8,4" />
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Deceleration, Mode=TwoWay}" />
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem Content="{Binding StatusMessage}" />
        </StatusBar>
    </Grid>
</UserControl>
