<UserControl x:Class="DispenserEditor.Controls.PathSegmentEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:prpt="http://propertytools.org/wpf"
             xmlns:models="clr-namespace:DispenserEditor.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             MinHeight="600"
             MinWidth="1024">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="SegmentTypes"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SegmentType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar x:Name="MainToolBar"
                 Grid.ColumnSpan="2"
                 Background="#e0e4e9"
                 Padding="6"
                 BorderThickness="0"
                 ToolBarTray.IsLocked="True">
            <Button Click="OnLoadImage">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Image" Margin="0,0,6,0" />
                    <TextBlock Text="Load Image" Margin="0" />
                </StackPanel>
            </Button>

            <Button Click="OnResetImage">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="ArrowRotateLeft" Margin="0,0,6,0" />
                    <TextBlock Text="Reset Image" Margin="0" />
                </StackPanel>
            </Button>

            <Separator />

            <Button Click="OnAddLineSegment">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Pen" Margin="0,0,6,0" />
                    <TextBlock Text="Add Line" Margin="0" />
                </StackPanel>
            </Button>

            <Button Click="OnAddPointSegment">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="LocationCrosshairs" Margin="0,0,6,0" />
                    <TextBlock Text="Add Point" Margin="0" />
                </StackPanel>
            </Button>

            <Button Click="OnRemoveSegment">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Trash" Margin="0,0,6,0" />
                    <TextBlock Text="Remove Segment" Margin="0" />
                </StackPanel>
            </Button>

            <Separator />

            <Button Click="OnResetView">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <fa:IconBlock Icon="Expand" Margin="0,0,6,0" />
                    <TextBlock Text="Reset View" Margin="0" />
                </StackPanel>
            </Button>
        </ToolBar>

        <Grid Grid.Row="1" Grid.Column="0" ClipToBounds="True">
            <Border x:Name="CanvasBorder" BorderThickness="1" BorderBrush="#FF3E4B59">
                <Grid x:Name="CanvasHost" Background="#FF111820"
                      SizeChanged="OnCanvasHostSizeChanged"
                      MouseWheel="OnCanvasMouseWheel"
                      MouseDown="OnCanvasMouseDown"
                      MouseMove="OnCanvasMouseMove"
                      MouseUp="OnCanvasMouseUp"
                      MouseLeave="OnCanvasMouseLeave">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" />
                            <TranslateTransform x:Name="PanTransform" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Image x:Name="ReferenceImage" Stretch="None" Source="{Binding ReferenceImage}" />
                    <Canvas x:Name="DrawingCanvas"
                            Background="Transparent"
                            IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GroupBox Header="Recipe Items">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Content="Add" Width="60" Margin="0,0,8,0" Click="OnAddItem" />
                        <Button Content="Remove" Width="80" Click="OnRemoveItem" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Height="120" />
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Segments" Margin="0,12,0,0">
                <DataGrid ItemsSource="{Binding Segments}"
                          SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Type"
                                                SelectedItemBinding="{Binding SegmentType, Mode=TwoWay}"
                                                ItemsSource="{Binding Source={StaticResource SegmentTypes}}" />
                        <DataGridTextColumn Header="X" Binding="{Binding X, Mode=TwoWay, StringFormat=F3}" Width="*" />
                        <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=TwoWay, StringFormat=F3}" Width="*" />
                        <DataGridTextColumn Header="Group" Binding="{Binding LineGroup, Mode=TwoWay}" Width="*" />
                        <DataGridCheckBoxColumn Header="Dispense" Binding="{Binding OnDispensing, Mode=TwoWay}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Segment Details" Margin="0,12,0,0">
                <prpt:PropertyGrid SelectedObject="{Binding SelectedSegment}" AutoGenerateProperties="True" />
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Item Settings" Margin="0,12,0,0">
                <prpt:PropertyGrid SelectedObject="{Binding SelectedItem}" AutoGenerateProperties="True" />
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Center:" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding AppliedCenterX, StringFormat=F3}" />
                    <TextBlock Text="," Margin="2,0" />
                    <TextBlock Text="{Binding AppliedCenterY, StringFormat=F3}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
