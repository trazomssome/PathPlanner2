<UserControl x:Class="DispenserEditor.Controls.PathEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prpt="http://propertytools.org/wpf"
             xmlns:viewModels="clr-namespace:DispenserEditor.ViewModels"
             mc:Ignorable="d"
             MinHeight="600"
             MinWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0"
                 Padding="6"
                 ToolBarTray.IsLocked="True">
            <Button Content="Load Image" Click="OnLoadImage" Margin="4,0" />
            <Separator />
            <Button Content="Import" Click="OnImport" Margin="4,0" />
            <Button Content="Export" Click="OnExport" Margin="4,0" />
            <Separator />
            <Button Content="Undo" Click="OnUndo" Margin="4,0" IsEnabled="{Binding CanUndo}" />
            <Button Content="Redo" Click="OnRedo" Margin="4,0" IsEnabled="{Binding CanRedo}" />
        </ToolBar>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Recipe Items" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add" Click="OnAddItem" Margin="0,0,8,0" />
                        <Button Content="Remove" Click="OnRemoveItem" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             DisplayMemberPath="Name" />

                    <prpt:PropertyGrid Grid.Row="2"
                                       Margin="0,8,0,0"
                                       SelectedObject="{Binding SelectedItem}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Segments">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add Point" Click="OnAddPointSegment" Margin="0,0,8,0" />
                        <Button Content="Add Line" Click="OnAddLineSegment" Margin="0,0,8,0" />
                        <Button Content="Remove" Click="OnRemoveSegment" Margin="0,0,8,0" />
                        <Button Content="Clear" Click="OnClearSegments" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="False"
                              ItemsSource="{Binding Segments}"
                              SelectedItem="{Binding SelectedSegment, Mode=TwoWay}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Type"
                                                     SelectedItemBinding="{Binding SegmentType, Mode=TwoWay}"
                                                     ItemsSource="{x:Static viewModels:SegmentTypeCollection.All}" />
                            <DataGridCheckBoxColumn Header="Dispense" Binding="{Binding OnDispensing, Mode=TwoWay}" />
                            <DataGridTextColumn Header="Group" Binding="{Binding LineGroup, Mode=TwoWay}" />
                            <DataGridTextColumn Header="X" Binding="{Binding X, Mode=TwoWay, StringFormat=F3}" />
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=TwoWay, StringFormat=F3}" />
                            <DataGridTextColumn Header="Speed" Binding="{Binding Speed, Mode=TwoWay}" />
                            <DataGridTextColumn Header="Accel" Binding="{Binding Acceleration, Mode=TwoWay}" />
                            <DataGridTextColumn Header="Decel" Binding="{Binding Deceleration, Mode=TwoWay}" />
                            <DataGridCheckBoxColumn Header="Auto Smooth" Binding="{Binding AutoSmoothing, Mode=TwoWay}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <prpt:PropertyGrid Grid.Row="2"
                                       Margin="0,8,0,0"
                                       SelectedObject="{Binding SelectedSegment}" />
                </Grid>
            </GroupBox>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFEFEFEF"
                Padding="8">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</UserControl>
