                            </StackPanel>
                        </StackPanel>
                    </Border>-->
                </Grid>
            </GroupBox>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="DarkSlateGray" />
        </Grid>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Text="Coordinates are in millimetres (3 decimal places)" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
