
<Window x:Class="DispenserEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DispenserEditor.ViewModels"
        xmlns:converters="clr-namespace:DispenserEditor.Converters"
        xmlns:models="clr-namespace:DispenserEditor.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="도포 경로 편집기"
        MinWidth="1100"
        MinHeight="700">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:OffsetConverter x:Key="OffsetConverter" />
        <converters:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <ObjectDataProvider x:Key="CoordinateTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:CoordinateType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="CoordinateThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Circle"
                                     Width="{TemplateBinding Width}"
                                     Height="{TemplateBinding Height}"
                                     StrokeThickness="1.5"
                                     Stroke="#FF1A1A1A"
                                     Fill="#FF2E8DEF" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:CoordinateType.Point}">
                                <Setter TargetName="Circle" Property="Fill" Value="#FFE3A21A" />
                            </DataTrigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                        <Binding />
                                        <Binding Path="DataContext.SelectedCoordinate" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="Circle" Property="Stroke" Value="#FF0050EF" />
                                <Setter TargetName="Circle" Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFECECEC" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="모드" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold" />
                    <RadioButton Content="이동" GroupName="Mode" Margin="0,0,6,0"
                                 IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Move}" />
                    <RadioButton Content="선" GroupName="Mode" Margin="0,0,6,0"
                                 IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Line}" />
                    <RadioButton Content="점" GroupName="Mode" Margin="0,0,6,0"
                                 IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Point}" />
                    <RadioButton Content="센터" GroupName="Mode"
                                 IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Center}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="mm/px" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="80" TextAlignment="Right" Text="{Binding MmPerPixel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="투명도" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider Width="140" Minimum="0.1" Maximum="1" Value="{Binding RecipeOpacity, Mode=TwoWay}" />
                    <Button Content="센터 초기화" Margin="12,0,0,0" Click="ResetCenter_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="3">
                    <Button Content="Undo" Margin="0,0,6,0" Command="{Binding UndoCommand}" />
                    <Button Content="Redo" Margin="0,0,12,0" Command="{Binding RedoCommand}" />
                    <Button Content="이미지 불러오기" Margin="0,0,6,0" Command="{Binding LoadImageCommand}" />
                    <Button Content="JSON 내보내기" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drawing Surface -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF1E1E1E">
            <Grid>
                <Image Source="{Binding ReferenceImage}" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Stretch="Fill" />
                <Canvas x:Name="DrawingCanvas"
                        Width="{Binding CanvasWidth}"
                        Height="{Binding CanvasHeight}"
                        Background="#11000000"
                        MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                        MouseRightButtonDown="DrawingCanvas_MouseRightButtonDown">

                    <Line X1="{Binding CenterPixelX}" Y1="0" X2="{Binding CenterPixelX}" Y2="{Binding CanvasHeight}"
                          Stroke="#66FFFFFF" StrokeDashArray="4 4" IsHitTestVisible="False" />
                    <Line X1="0" Y1="{Binding CenterPixelY}" X2="{Binding CanvasWidth}" Y2="{Binding CenterPixelY}"
                          Stroke="#66FFFFFF" StrokeDashArray="4 4" IsHitTestVisible="False" />

                    <ItemsControl ItemsSource="{Binding LineSegments}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                      Stroke="#FF2E8DEF"
                                      StrokeThickness="2.5"
                                      Opacity="{Binding DataContext.RecipeOpacity, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Coordinates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <Binding Path="PixelX" Converter="{StaticResource OffsetConverter}" ConverterParameter="-6" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Canvas.Top">
                                    <Setter.Value>
                                        <Binding Path="PixelY" Converter="{StaticResource OffsetConverter}" ConverterParameter="-6" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Thumb Style="{StaticResource CoordinateThumbStyle}"
                                           DragDelta="CoordinateThumb_DragDelta"
                                           DragStarted="CoordinateThumb_DragStarted"
                                           DragCompleted="CoordinateThumb_DragCompleted"
                                           PreviewMouseLeftButtonDown="CoordinateThumb_PreviewMouseLeftButtonDown" />
                                    <Border Background="#BF000000" Padding="2" Margin="12,-22,0,0" CornerRadius="2">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- Inspector Panel -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="레시피 설정" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Default Speed" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="8,0,0,4" TextAlignment="Right" Text="{Binding DefaultSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Row="1" Content="속도 제한 사용" IsChecked="{Binding SpeedLimitEnabled, Mode=TwoWay}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,4" TextAlignment="Right" Text="{Binding SpeedLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Text="센터(px)" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="X:" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CenterPixelX, StringFormat=F2}" Margin="4,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Y:" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CenterPixelY, StringFormat=F2}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="좌표 목록" Padding="0" Margin="0,0,0,12">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="12" DockPanel.Dock="Top">
                        <Button Content="위로" Width="60" Margin="0,0,6,0" Command="{Binding MoveUpCommand}" />
                        <Button Content="아래로" Width="60" Command="{Binding MoveDownCommand}" />
                        <Button Content="삭제" Width="60" Margin="6,0,0,0" Command="{Binding DeleteCoordinateCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Coordinates}"
                             SelectedItem="{Binding SelectedCoordinate, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Margin="12"
                             MinHeight="200" />
                </DockPanel>
            </GroupBox>

            <Border Grid.Row="2" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="선택 좌표 편집" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="선택된 좌표가 없습니다." Foreground="#99000000">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCoordinate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,8,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCoordinate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.DataContext>
                            <Binding Path="SelectedCoordinate" />
                        </Grid.DataContext>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="이름" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="8,0,0,4" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="타입" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,4" ItemsSource="{Binding Source={StaticResource CoordinateTypes}}" SelectedItem="{Binding Type, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Text="X (mm)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,4" TextAlignment="Right" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />

                        <TextBlock Grid.Row="3" Text="Y (mm)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,4" TextAlignment="Right" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />

                        <CheckBox Grid.Row="4" Content="개별 속도 사용" IsChecked="{Binding UseCustomSpeed, Mode=TwoWay}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="8,0,0,4" TextAlignment="Right" Text="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseCustomSpeed}" />

                        <TextBlock Grid.Row="5" Text="가/감속 (mm/s²)" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <TextBox Width="70" TextAlignment="Right" Text="{Binding Acceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                            <TextBox Width="70" TextAlignment="Right" Text="{Binding Deceleration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox Content="도포기 사용" IsChecked="{Binding DispenseEnabled, Mode=TwoWay}" Margin="0,0,12,0" />
                            <CheckBox Content="자동 스무딩" IsChecked="{Binding UseAutoSmoothing, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
