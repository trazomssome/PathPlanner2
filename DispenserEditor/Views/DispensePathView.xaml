<UserControl x:Class="DispenserEditor.Views.DispensePathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <ToolBar Grid.ColumnSpan="2" Padding="8">
            <Button Content="Pointer" Command="{Binding PointerToolCommand}" Margin="0,0,4,0" />
            <Button Content="Add Point" Command="{Binding AddPointToolCommand}" Margin="0,0,16,0" />
            <Button Content="Zoom In" Command="{Binding ZoomInCommand}" Margin="0,0,4,0" />
            <Button Content="Zoom Out" Command="{Binding ZoomOutCommand}" Margin="0,0,4,0" />
            <Button Content="Zoom Fit" Command="{Binding ZoomFitCommand}" Margin="0,0,16,0" />
            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,4,0" />
            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,16,0" />
            <Button Content="Add" Command="{Binding AddCommand}" Margin="0,0,4,0" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" />
        </ToolBar>

        <wfi:WindowsFormsHost x:Name="EditorHost"
                              Grid.Row="1"
                              Grid.Column="0"
                              Margin="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />

        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      Margin="8"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <GroupBox Header="Recipe" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Recipe Name" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,4"
                                 Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,4">
                            <Button Content="Load" Command="{Binding LoadParametersCommand}" Margin="0,0,4,0" />
                            <Button Content="Save" Command="{Binding SaveParametersCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Pixel Size X" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="8,4,0,4"
                                 Text="{Binding PixelSizeX, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="Pixel Size Y" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="8,4,0,4"
                                 Text="{Binding PixelSizeY, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="Background" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="8,4,0,4"
                                 IsReadOnly="True"
                                 Text="{Binding BackgroundImagePath}" />

                        <StackPanel Grid.Row="4"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    Margin="0,8,0,0">
                            <Button Content="Load Image" Command="{Binding LoadImageCommand}" Margin="0,0,4,0" />
                            <Button Content="Load Test Image" Command="{Binding LoadTestImageCommand}" Margin="0,0,4,0" />
                            <Button Content="Clear" Command="{Binding ClearCommand}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Polyline Start Parameters" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Open Time (ms)" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,4"
                                 IsEnabled="{Binding StartParameters.IsEnabled}"
                                 Text="{Binding StartParameters.OpenTime, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="Close Time (ms)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="8,4,0,4"
                                 IsEnabled="{Binding StartParameters.IsEnabled}"
                                 Text="{Binding StartParameters.CloseTime, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="Pulses" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Margin="8,4,0,4"
                                 IsEnabled="{Binding StartParameters.IsEnabled}"
                                 Text="{Binding StartParameters.Pulse, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Row="3"
                                Grid.Column="2"
                                Margin="8,8,0,0"
                                Content="Apply"
                                Command="{Binding ApplyStartParametersCommand}"
                                IsEnabled="{Binding StartParameters.IsEnabled}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Align Compensation" Margin="0,0,0,12">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="dX" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="8,0,0,4" Text="{Binding AlignDx, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Text="dY" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4" Text="{Binding AlignDy, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Text="Theta (deg)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="8,4,0,4" Text="{Binding AlignTheta, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Text="Unit X" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="8,4,0,4" Text="{Binding UnitX, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Text="Unit Y" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="8,4,0,4" Text="{Binding UnitY, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="Cam→Disp X" VerticalAlignment="Center" />
                                <TextBox Width="80"
                                         Margin="8,0,0,0"
                                         Text="{Binding CamToDispX, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cam→Disp Y" VerticalAlignment="Center" />
                                <TextBox Width="80"
                                         Margin="8,0,0,0"
                                         Text="{Binding CamToDispY, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Content="Apply Align"
                                Command="{Binding TestAlignCommand}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Points">
                    <DataGrid ItemsSource="{Binding Points}"
                              SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="8"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FontSize" Value="14" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPolylineStart}" Value="True">
                                        <Setter Property="Background" Value="#FFE8F4FF" />
                                        <Setter Property="BorderBrush" Value="#FFCCE4F7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat=F3}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat=F3}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
